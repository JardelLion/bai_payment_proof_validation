<odoo>
    <record id="view_bay_payment_proof_validation_res_config_settings" model="ir.ui.view">
        <field name="name">bay.payment.proof.validation.config.settings</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='cf-turnstile']" position="after">
                <setting string="BAI API Url">
                    <div class="text-muted content-group mt16">
                        <field name="bai_validate_api_url" placeholder="https://your-bai-api-server/api/"/>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
